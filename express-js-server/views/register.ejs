<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Vistaar — Register</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #171923;
    --ink-soft: #232637;
    --parchment: #F5F1E8;
    --parchment-dim: #EDE7D8;
    --card: #FFFFFF;
    --brass: #B8863C;
    --brass-light: #D9B679;
    --brass-wash: rgba(184,134,60,0.12);
    --slate: #6B7280;
    --slate-dark: #3E4453;
    --rust: #B3452C;
    --line: rgba(245,241,232,0.14);
    --line-soft: rgba(23,25,35,0.10);
    --page-bg: #EDE7D8;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --page-bg: #14151B; }
  }
  :root[data-theme="dark"] { --page-bg: #14151B; }

  * { box-sizing: border-box; }

  html, body {
    margin: 0; padding: 0;
    background: var(--page-bg);
    font-family: "Work Sans", -apple-system, "Segoe UI", sans-serif;
    color: var(--ink);
  }

  /* ---------- Top nav ---------- */
  .topnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 40px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .brand {
    font-family: "Fraunces", Georgia, serif;
    font-size: 21px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .brand span { color: var(--brass); }

  nav.primary-nav { display: flex; align-items: center; gap: 30px; }
  nav.primary-nav a {
    color: var(--slate-dark);
    text-decoration: none;
    font-size: 14.5px;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  nav.primary-nav a:hover { color: var(--ink); }
  nav.primary-nav a.current { color: var(--ink); border-bottom: 1px solid var(--brass); font-weight: 500; }

  .nav-toggle {
    display: none;
    width: 36px; height: 36px;
    align-items: center; justify-content: center;
    background: transparent; border: 1px solid var(--line-soft);
    border-radius: 4px; color: var(--ink); cursor: pointer;
  }

  /* ---------- Page body ---------- */
  .page-wrap {
    display: flex;
    justify-content: center;
    padding: 20px 20px 70px;
  }

  .register-card {
    width: 100%;
    max-width: 640px;
    background: var(--card);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    padding: 42px 46px 46px;
    box-shadow: 0 30px 70px -35px rgba(23,25,35,0.28);
  }

  .register-card .kicker {
    font-size: 13px;
    color: var(--brass);
    font-weight: 500;
    margin-bottom: 8px;
  }
  .register-card h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 27px;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .register-card .sub {
    font-size: 14.5px;
    color: var(--slate);
    margin: 0 0 30px;
  }

  form { display: flex; flex-direction: column; gap: 18px; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }

  .field { display: flex; flex-direction: column; gap: 7px; }
  .field label { font-size: 13px; color: var(--slate-dark); font-weight: 500; }
  .field .hint { font-size: 11.5px; color: var(--slate); font-weight: 400; margin-left: 4px; }

  .field input,
  .field select,
  .field textarea {
    border: 1px solid var(--line-soft);
    background: #fff;
    border-radius: 4px;
    padding: 12px 14px;
    font-size: 14.5px;
    font-family: inherit;
    color: var(--ink);
    outline: none;
    width: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field textarea { resize: vertical; min-height: 78px; }
  .field input::placeholder,
  .field textarea::placeholder { color: #B3AC9C; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(184,134,60,0.18);
  }

  .gender-group { display: flex; flex-direction: column; gap: 7px; }
  .gender-group .label { font-size: 13px; color: var(--slate-dark); font-weight: 500; }
  .gender-options { display: flex; gap: 22px; flex-wrap: wrap; }
  .gender-option {
    display: flex; align-items: center; gap: 8px;
    font-size: 14px; color: var(--ink);
  }
  .gender-option input {
    width: 16px; height: 16px;
    accent-color: var(--brass);
    margin: 0;
  }

  .terms-line {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    color: var(--slate-dark);
    line-height: 1.5;
  }
  .terms-line input { margin-top: 3px; accent-color: var(--brass); }
  .terms-line a { color: var(--brass); text-decoration: none; }
  .terms-line a:hover { text-decoration: underline; }

  button.submit {
    margin-top: 6px;
    background: var(--ink);
    color: var(--parchment);
    border: none;
    border-radius: 4px;
    padding: 14px 18px;
    font-size: 15px;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  button.submit:hover { background: var(--slate-dark); }
  button.submit:active { transform: translateY(1px); }
  button.submit:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }

  .login-line {
    text-align: center;
    font-size: 14px;
    color: var(--slate-dark);
    margin-top: 6px;
  }
  .login-line a { color: var(--brass); text-decoration: none; font-weight: 500; }
  .login-line a:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }
  .fade-in { animation: fadeIn 0.5s ease both; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 720px) {
    .topnav { padding: 18px 20px; }
    .nav-toggle { display: inline-flex; }
    nav.primary-nav {
      display: none;
      position: absolute;
      top: 64px; left: 20px; right: 20px;
      background: var(--card);
      border: 1px solid var(--line-soft);
      border-radius: 6px;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 10px;
      z-index: 5;
    }
    nav.primary-nav.open { display: flex; }
    nav.primary-nav a { width: 100%; padding: 10px 8px; }

    .register-card { padding: 30px 22px 34px; }
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="topnav">
  <a href="#home" class="brand"><span>Vistaar.</span></a>
  <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 4.5H16M2 9H16M2 13.5H16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </button>
  <nav class="primary-nav" id="primaryNav">
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
    <a href="#register" class="current">Register</a>
    <a href="#login">Login</a>
  </nav>
</div>

<div class="page-wrap">
  <div class="register-card fade-in">
    
      <%
           if(message!="")
           {
            %>  
                <h1 style="color: rgb(10, 113, 56);"><%=message%></h1>
            <%
           }
      %>
    <div class="kicker">Join Vistaar</div>
    <h1>Create your account</h1>
    <p class="sub">Fill in your details below to get started.</p>

    <!-- Plain HTML form submit — no AJAX / fetch, no JS interception -->
    
    <form action="/register" method="POST">

      <div class="field">
        <label for="fullname">Full name</label>
        <input type="text" id="fullname" name="fullname" placeholder="Enter your full name" required />
      </div>

      <div class="grid-2">
        <div class="field">
          <label for="dob">Date of birth</label>
          <input type="date" id="dob" name="dob" required />
        </div>
        <div class="field">
          <label for="mobile">Mobile number</label>
          <input type="tel" id="mobile" name="mobile" placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10" required />
        </div>
      </div>

      <div class="field">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required />
      </div>

      <div class="field">
        <label for="password">Password <span class="hint">(min. 8 characters)</span></label>
        <input type="password" id="password" name="password" placeholder="Create a password" minlength="8" required />
      </div>

      <div class="field">
        <label for="address">Address</label>
        <textarea id="address" name="address" placeholder="House no., street, city, state, PIN code" required></textarea>
      </div>

      <div class="gender-group">
        <div class="label">Gender</div>
        <div class="gender-options">
          <label class="gender-option"><input type="radio" name="gender" value="female" required /> Female</label>
          <label class="gender-option"><input type="radio" name="gender" value="male" /> Male</label>
          <label class="gender-option"><input type="radio" name="gender" value="other" /> Other</label>
        </div>
      </div>

      <label class="terms-line">
        <input type="checkbox" name="terms" required />
        I agree to the <a href="#terms">Terms of Service</a> and <a href="#privacy">Privacy Policy</a>.
      </label>

      <button type="submit" class="submit">Create account</button>
    </form>

    <p class="login-line">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>

<script>
  // Mobile nav toggle only — no AJAX, no fetch, the form above submits normally.
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('primaryNav');
  toggle.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>

</body>
</html>
