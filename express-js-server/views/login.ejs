<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Vistaar — Login</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #171923;
    --ink-soft: #232637;
    --parchment: #F5F1E8;
    --parchment-dim: #EDE7D8;
    --brass: #B8863C;
    --brass-light: #D9B679;
    --slate: #6B7280;
    --slate-dark: #3E4453;
    --rust: #B3452C;
    --line: rgba(245,241,232,0.14);
    --line-soft: rgba(23,25,35,0.12);
    --page-bg: #0F1015;
    --focus-ring: #D9B679;
  }

  :root:not([data-theme="light"]) { --page-bg: #0F1015; }
  :root[data-theme="dark"] { --page-bg: #0B0C10; }
  :root[data-theme="light"] { --page-bg: #E9E4D6; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --page-bg: #0B0C10; }
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--page-bg);
    font-family: "Work Sans", -apple-system, "Segoe UI", sans-serif;
    color: var(--ink);
  }

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
  }

  .frame {
    width: 100%;
    max-width: 1180px;
    min-height: 680px;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--parchment);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(0,0,0,0.55);
  }

  .hero {
    background: var(--ink);
    color: var(--parchment);
    position: relative;
    padding: 36px 48px 48px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    right: -140px;
    top: -140px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  .hero::after {
    content: "";
    position: absolute;
    right: -40px;
    bottom: -180px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  .brand {
    font-family: "Fraunces", Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--parchment);
    text-decoration: none;
  }
  .brand span { color: var(--brass-light); }

  nav.primary-nav {
    margin-top: 44px;
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }
  nav.primary-nav a {
    color: var(--parchment);
    opacity: 0.72;
    text-decoration: none;
    font-size: 15px;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }
  nav.primary-nav a:hover { opacity: 1; }
  nav.primary-nav a.current {
    opacity: 1;
    border-bottom: 1px solid var(--brass-light);
  }

  .hero-copy {
    margin-top: auto;
    position: relative;
    z-index: 2;
    max-width: 420px;
  }
  .hero-copy h1 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(30px, 3.4vw, 40px);
    line-height: 1.18;
    margin: 0 0 18px;
    color: var(--parchment);
  }
  .hero-copy p {
    font-size: 15.5px;
    line-height: 1.65;
    color: rgba(245,241,232,0.68);
    margin: 0 0 30px;
    max-width: 380px;
  }

  .hero-stats {
    display: flex;
    gap: 36px;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    position: relative;
    z-index: 2;
  }
  .hero-stats .stat b {
    display: block;
    font-family: "Fraunces", Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    color: var(--brass-light);
  }
  .hero-stats .stat span {
    font-size: 12.5px;
    color: rgba(245,241,232,0.58);
  }

  .form-side {
    background: var(--parchment);
    padding: 48px 52px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .form-side .eyebrow-link {
    align-self: flex-end;
    font-size: 14px;
    color: var(--slate-dark);
    text-decoration: none;
    margin-bottom: 28px;
  }
  .form-side .eyebrow-link strong {
    color: var(--brass);
    font-weight: 600;
  }

  .form-side h2 {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 500;
    font-size: 27px;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .form-side .sub {
    font-size: 14.5px;
    color: var(--slate);
    margin: 0 0 32px;
  }

  form { display: flex; flex-direction: column; gap: 18px; }

  .field { display: flex; flex-direction: column; gap: 7px; }
  .field label {
    font-size: 13px;
    color: var(--slate-dark);
    font-weight: 500;
  }
  .field input {
    border: 1px solid var(--line-soft);
    background: #fff;
    border-radius: 4px;
    padding: 12px 14px;
    font-size: 15px;
    font-family: inherit;
    color: var(--ink);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .field input::placeholder { color: #B3AC9C; }
  .field input:focus {
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(184,134,60,0.18);
  }
  .field input:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  .row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
    margin-top: -4px;
  }
  .checkline {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--slate-dark);
  }
  .checkline input { accent-color: var(--brass); width: 15px; height: 15px; }
  .row-between a { color: var(--brass); text-decoration: none; }
  .row-between a:hover { text-decoration: underline; }

  button.submit {
    margin-top: 8px;
    background: var(--ink);
    color: var(--parchment);
    border: none;
    border-radius: 4px;
    padding: 14px 18px;
    font-size: 15px;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  button.submit:hover { background: var(--slate-dark); }
  button.submit:active { transform: translateY(1px); }
  button.submit:focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--slate);
    font-size: 12.5px;
    margin: 22px 0 18px;
  }
  .divider::before, .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line-soft);
  }

  .register-line {
    text-align: center;
    font-size: 14px;
    color: var(--slate-dark);
  }
  .register-line a { color: var(--brass); text-decoration: none; font-weight: 500; }
  .register-line a:hover { text-decoration: underline; }

  .error-msg {
    display: none;
    font-size: 13px;
    color: var(--rust);
    background: rgba(179,69,44,0.08);
    border: 1px solid rgba(179,69,44,0.28);
    border-radius: 4px;
    padding: 10px 12px;
  }
  .error-msg.show { display: block; }

  .nav-toggle { display: none; }

  @media (max-width: 900px) {
    .frame { grid-template-columns: 1fr; min-height: auto; }
    .hero { padding: 28px 24px 40px; }
    .hero-copy { margin-top: 36px; }
    .hero-stats { margin-top: 30px; }
    .form-side { padding: 40px 26px 46px; }

    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--parchment);
      cursor: pointer;
    }
    .top-row { display: flex; align-items: center; justify-content: space-between; }
    nav.primary-nav {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      margin-top: 22px;
      width: 100%;
    }
    nav.primary-nav.open { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; }
  }

  .fade-in { animation: fadeIn 0.6s ease both; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>

<div class="frame fade-in">

  <div class="hero">
    <div class="top-row">
      <a href="#home" class="brand">Vistaar<span>.</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4.5H16M2 9H16M2 13.5H16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="primary-nav" id="primaryNav">
     <%-include("menu")%>
    </nav>

    <div class="hero-copy">
      <h1>Learning never stops being a journey.</h1>
      <p>Log in to your account and pick up right where you left off — courses, notes, and progress, all in one place.</p>
    </div>

    <div class="hero-stats">
      <div class="stat"><b>12,400+</b><span>active learners</span></div>
      <div class="stat"><b>340</b><span>courses available</span></div>
      <div class="stat"><b>4.8/5</b><span>average rating</span></div>
    </div>
  </div>

  <div class="form-side">
    <%
           if(message!="")
           {
            %>  
              <h3 style="color: rgb(113, 43, 10);"><%=message%></h3>
            <%
           }
      %>
    <a href="/register" class="eyebrow-link">New here? <strong>Register</strong></a>

    <h2>Welcome back</h2>
    <p class="sub">Enter your details to continue.</p>

    <div class="error-msg" id="errorMsg">That email or password doesn't look right. Please try again.</div>

    <form id="loginForm" method="post" action="/login">
      <div class="field">
        <label for="email">Email address</label>
        <input type="text" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password" minlength="6" />
      </div>

      <div class="row-between">
        <label class="checkline">
          <input type="checkbox" name="remember" />
          Remember me
        </label>
        <a href="#forgot">Forgot password?</a>
      </div>

      <button type="submit" class="submit">Log in</button>
    </form>

    <div class="divider">or</div>
    <p class="register-line">Don't have an account? <a href="#register">Register here</a></p>
  </div>

</div>

