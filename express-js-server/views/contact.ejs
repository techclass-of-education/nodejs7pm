
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600&display=swap');

        :root {
            --paper: #f6f3ec;
            --ink: #262220;
            --ink-soft: #625b54;
            --rule: #d8d1c4;
            --accent: #6b5a3e;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Source Sans 3', sans-serif;
            font-size: 17px;
            line-height: 1.6;
        }

        .page {
            max-width: 680px;
            margin: 0 auto;
            padding: 5rem 1.5rem 6rem;
        }

        header {
            margin-bottom: 3.5rem;
        }

        header h1 {
            font-family: 'Fraunces', serif;
            font-weight: 500;
            font-size: 2.75rem;
            letter-spacing: -0.01em;
            margin: 0 0 0.75rem;
            color: var(--ink);
        }

        header p {
            margin: 0;
            color: var(--ink-soft);
            font-size: 1rem;
            max-width: 42ch;
        }

        hr {
            display: none;
        }

        .entry {
            padding: 2.75rem 0;
            border-top: 1px solid var(--rule);
            display: grid;
            grid-template-columns: 2.5rem 1fr;
            gap: 0.25rem 1.25rem;
        }

        .entry:last-child {
            border-bottom: 1px solid var(--rule);
        }

        .entry-index {
            font-family: 'Fraunces', serif;
            font-size: 1rem;
            color: var(--accent);
            padding-top: 0.2rem;
        }

        .entry h3 {
            font-family: 'Fraunces', serif;
            font-weight: 500;
            font-size: 1.5rem;
            margin: 0 0 0.6rem;
            grid-column: 2;
        }

        .entry p {
            grid-column: 2;
            margin: 0;
            color: var(--ink-soft);
            max-width: 58ch;
        }

        @media (max-width: 520px) {
            .page {
                padding: 3rem 1.25rem 4rem;
            }

            header h1 {
                font-size: 2.2rem;
            }

            .entry {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }

            .entry-index {
                grid-row: 1;
            }

            .entry h3,
            .entry p {
                grid-column: 1;
            }
        }
    </style>
</head>

<body>
